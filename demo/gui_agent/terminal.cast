[0.001, "o", "\u001b[1;33m  ! gui_click after release → 404 Invalid or expired hijack session.\u001b[0m\r\n"]
[0.000, "o", "\u001b[1;32m  ✓ every tool answered, and an unreachable rfb console fails as a bad gateway, not a bad request\u001b[0m\r\n"]
