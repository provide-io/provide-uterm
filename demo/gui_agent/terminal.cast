[0.410, "o", "\r\n\u001b[1;35m══════════════════════════════════════════════════════════════════════════════════════════════════════════════\u001b[0m\r\n\u001b[1;35m  \u001b[1mAn agent takes the graphical lease, screenshots a live desktop, clicks and types on it, then hands it back\u001b[0m\u001b[1;35m  \u001b[0m\r\n\u001b[1;35m══════════════════════════════════════════════════════════════════════════════════════════════════════════════\u001b[0m\r\n\r\n\u001b[1;36m  → Starting the uterm-test-vnc lab desktop...\u001b[0m\r\n"]
[0.185, "o", "    \u001b[2mlab:\u001b[0m \u001b[1muterm-demo-gui-agent :25902 (plain)\u001b[0m\r\n"]
[0.818, "o", "    \u001b[2mlease:\u001b[0m \u001b[1mfc11faca-8183-4716-bf1b-068094d4b2f9\u001b[0m\r\n"]
[0.292, "o", "    \u001b[2mattached:\u001b[0m \u001b[1mlab-vnc-plain (rfb, status 200)\u001b[0m\r\n\u001b[1;36m  → The console is a real X desktop over RFB, not a stub framebuffer.\u001b[0m\r\n"]
[0.000, "o", "\u001b[1;36m  →   -> gui_screenshot(before)\u001b[0m\r\n"]
[0.013, "o", "\u001b[1;32m  ✓ gui_screenshot -> 4737 bytes of PNG\u001b[0m\r\n\u001b[1;36m  →   -> gui_click(x=300, y=200, button='left')\u001b[0m\r\n"]
[0.615, "o", "\u001b[1;36m  →   -> gui_type(text=\"echo 'an agent typed this'\")\u001b[0m\r\n"]
[1.505, "o", "\u001b[1;36m  →   -> gui_key(key_name='Return')\u001b[0m\r\n"]
[1.504, "o", "\u001b[1;36m  →   -> gui_drag(start=(60,96) end=(420,96))\u001b[0m\r\n"]
[0.808, "o", "\u001b[1;36m  →   -> gui_screenshot(after)\u001b[0m\r\n"]
[0.044, "o", "\u001b[1;32m  ✓ gui_screenshot -> 755596 bytes of PNG\u001b[0m\r\n\u001b[1;36m  →   -> gui_hijack_release()\u001b[0m\r\n"]
[0.003, "o", "\u001b[1;32m  ✓ lease released -- the desktop is arbitrable again\u001b[0m\r\n\u001b[1;36m  → Without the lease those injections are dropped: the RFB input filter\u001b[0m\r\n\u001b[1;36m  → gates KeyEvent / PointerEvent / ClientCutText and fails closed.\u001b[0m\r\n"]
