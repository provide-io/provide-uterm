{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "strict": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "useUnknownInCatchVariables": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    // provide-uterm-ts is consumed as source over a workspace link, and its
    // own modules import each other with explicit .ts specifiers. Legal here
    // because this project only ever typechecks — Vite does the building.
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "paths": {
      "@provide-uterm-frontend/*": ["../provide-uterm-frontend/src/*"]
    }
  },
  "include": ["src"]
}
