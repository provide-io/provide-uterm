{
  "name": "provide-uterm-app",
  "version": "0.5.4",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/public.ts",
    "./extensions": "./src/extensions/index.ts",
    "./styles/tokens.css": "./src/styles/tokens.css"
  },
  "scripts": {
    "dev": "vite",
    "prebuild": "node ../../scripts/clean-frontend-generated.mjs",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint --error-on-warnings src/",
    "fix": "biome check --fix src/",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "provide-uterm-frontend": "*",
    "provide-uterm-ts": "*",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.8",
    "@types/jsdom": "^30.0.0",
    "jsdom": "^30.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.8"
  }
}
