SPDX-FileCopyrightText: Copyright (c) 2025-2026 provide.io llc. All rights reserved.
SPDX-License-Identifier: AGPL-3.0-or-later
-->
<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>

    <!--
      The version is read from the VERSION file beside this one, never written
      here. It used to be the literal 0.0.0-dev, and because this port has no
      packages/provide-uterm-csharp/VERSION the release consistency check (which
      walks packages/*/VERSION) had nothing to compare: the six Python packages
      went 0.5.0 to 0.5.4 while this one stayed at 0.0.0-dev, unnoticed. Reading
      the file is what makes that impossible rather than merely fixed once.
    -->
    <Version>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)VERSION').Trim())</Version>
    <Authors>provide.io</Authors>
    <Company>provide.io llc</Company>
    <Copyright>Copyright (c) 2025-2026 provide.io llc. All rights reserved.</Copyright>
    <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/provide-io/provide-uterm</PackageProjectUrl>
    <RepositoryUrl>https://github.com/provide-io/provide-uterm</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>terminal;pty;ssh;telnet;websocket;xterm;session;recording</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!--
      Symbols and source, so a consumer can step into the package rather than
      guess. SourceLink ships in the SDK, so this needs no PackageReference;
      ContinuousIntegrationBuild is what makes the build deterministic and is
      set only on CI, where the checkout path is stable.
    -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!-- The readme a NuGet consumer sees; only packable projects carry it. -->
  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <!--
    provide-telemetry is consumed as a published NuGet package, pinned like
    every other dependency in this repo.

    It used to be a git submodule wired in via a ProjectReference guarded by
    Exists(), which made the build shape depend on whether a directory
    happened to be present on disk: local builds compiled live source, while
    CI compiled against nothing unless that workflow remembered to set
    `submodules: true` on actions/checkout, in 30 separate places. That is the
    same "works on my machine" divergence the Python side already avoids by
    resolving provide-telemetry from PyPI.

    To develop against a local telemetry checkout, temporarily swap this for a
    ProjectReference to ../provide-telemetry/csharp/src/Provide.Telemetry/ and
    do not commit it, mirroring the [tool.uv.sources] note in CLAUDE.md.

    (No double hyphens anywhere in this comment: XML forbids them inside a
    comment, and MSBuild reports that as MSB4024 "could not be loaded" against
    every project at once, which looks like a broken build rather than a typo.)
  -->
  <PropertyGroup>
    <DefineConstants>$(DefineConstants);HAS_TELEMETRY</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Provide.Telemetry" Version="0.8.1" />
  </ItemGroup>
</Project>
