  "delegation": {
    "calls": [
      [
        "connect",
        "bbs.example.org",
        2323,
        [
          "origin"
        ]
      ],
      [
        "send",
        [
          108,
          115,
          13
        ]
      ],
      [
        "disconnect"
      ]
    ],
