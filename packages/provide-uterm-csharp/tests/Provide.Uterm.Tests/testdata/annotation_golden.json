  "rules": [
    {
      "category": "credentials",
      "description_template": "AWS access key detected in {event_type}",
      "event_types": [
        "read",
        "send"
      ],
      "label": "credential_exposure",
      "pattern": "AKIA[0-9A-Z]{12}",
      "rule_id": "cred.aws_access_key",
      "severity": "high"
    },
    {
      "category": "credentials",
      "description_template": "GitHub token detected in {event_type}",
      "event_types": [
        "read",
        "send"
      ],
      "label": "credential_exposure",
      "pattern": "gh[psourx]_[A-Za-z0-9_]{8}",
      "rule_id": "cred.github_token",
      "severity": "high"
    },
    {
      "category": "credentials",
      "description_template": "Secret assignment detected in {event_type}",
      "event_types": [
        "read",
        "send"
      ],
      "label": "credential_exposure",
      "pattern": "(?i)(password|secret|token|api_key)\\s*[=:]",
      "rule_id": "cred.generic_secret",
      "severity": "high"
    },
    {
      "category": "credentials",
      "description_template": "Bearer token detected in {event_type}",
      "event_types": [
        "read",
        "send"
      ],
      "label": "credential_exposure",
      "pattern": "Bearer\\s+\\S{8}",
      "rule_id": "cred.bearer_token",
      "severity": "high"
    },
    {
      "category": "credentials",
      "description_template": "Private key header detected: {match}",
      "event_types": [
        "read",
        "send"
      ],
      "label": "credential_exposure",
      "pattern": "-----BEGIN\\s+(RSA|EC|OPENSSH)\\s+PRIVATE KEY-----",
      "rule_id": "cred.private_key_header",
      "severity": "high"
    },
    {
      "category": "escalation",
      "description_template": "sudo command detected: {match}",
      "event_types": [
        "read",
        "send"
      ],
      "label": "privilege_escalation",
      "pattern": "\\bsudo\\b",
      "rule_id": "esc.sudo",
      "severity": "high"
    },
    {
      "category": "escalation",
      "description_template": "su - (switch to root) detected: {match}",
      "event_types": [
        "read",
        "send"
      ],
      "label": "privilege_escalation",
      "pattern": "\\bsu\\s+-",
      "rule_id": "esc.su_dash",
      "severity": "high"
    },
    {
      "category": "escalation",
      "description_template": "pkexec privilege escalation detected: {match}",
      "event_types": [
        "read",
        "send"
      ],
      "label": "privilege_escalation",
      "pattern": "\\bpkexec\\b",
      "rule_id": "esc.pkexec",
      "severity": "high"
    },
    {
      "category": "destructive",
      "description_template": "Recursive force-remove detected: {match}",
      "event_types": [
        "read",
        "send"
      ],
      "label": "destructive_command",
      "pattern": "\\brm\\s+(-[rRf]{2,}|-[rR]\\s+-f|-f\\s+-[rR])",
      "rule_id": "dest.rm_rf",
      "severity": "critical"
    },
    {
      "category": "destructive",
      "description_template": "SQL DROP statement detected: {match}",
      "event_types": [
        "read",
        "send"
      ],
      "label": "destructive_command",
      "pattern": "(?i)\\bDROP\\s+(TABLE|DATABASE)\\b",
      "rule_id": "dest.drop_table",
      "severity": "critical"
    },
    {
      "category": "destructive",
      "description_template": "kubectl delete command detected: {match}",
      "event_types": [
        "read",
        "send"
      ],
      "label": "destructive_command",
      "pattern": "\\bkubectl\\s+delete\\b",
      "rule_id": "dest.kubectl_delete",
      "severity": "critical"
    },
    {
      "category": "destructive",
      "description_template": "dd disk-copy command detected: {match}",
      "event_types": [
        "read",
        "send"
      ],
      "label": "destructive_command",
      "pattern": "\\bdd\\s+if=",
      "rule_id": "dest.dd_if",
      "severity": "critical"
    },
    {
      "category": "destructive",
      "description_template": "mkfs (format filesystem) detected: {match}",
      "event_types": [
        "read",
        "send"
      ],
      "label": "destructive_command",
      "pattern": "\\bmkfs\\.",
      "rule_id": "dest.mkfs",
      "severity": "critical"
    },
    {
      "category": "connections",
      "description_template": "SSH connection detected: {match}",
      "event_types": [
        "read",
        "send"
      ],
      "label": "outbound_connection",
      "pattern": "\\bssh\\s+[\\w.\\-]+@",
      "rule_id": "conn.ssh",
      "severity": "info"
    },
    {
      "category": "connections",
      "description_template": "curl HTTP request detected: {match}",
      "event_types": [
        "read",
        "send"
      ],
      "label": "outbound_connection",
      "pattern": "\\bcurl\\b.*https?://",
      "rule_id": "conn.curl",
      "severity": "info"
    },
    {
      "category": "connections",
      "description_template": "wget HTTP request detected: {match}",
      "event_types": [
        "read",
        "send"
      ],
      "label": "outbound_connection",
      "pattern": "\\bwget\\b.*https?://",
      "rule_id": "conn.wget",
      "severity": "info"
    },
    {
      "category": "connections",
      "description_template": "scp file transfer detected: {match}",
      "event_types": [
        "read",
        "send"
      ],
      "label": "outbound_connection",
      "pattern": "\\bscp\\b",
      "rule_id": "conn.scp",
      "severity": "info"
    },
    {
      "category": "lifecycle",
      "description_template": "exit command detected: {match}",
      "event_types": [
        "read",
        "send"
      ],
      "label": "session_lifecycle",
      "pattern": "\\bexit\\b",
      "rule_id": "life.exit",
      "severity": "info"
    },
    {
      "category": "lifecycle",
      "description_template": "shutdown command detected: {match}",
      "event_types": [
        "read",
        "send"
      ],
      "label": "session_lifecycle",
      "pattern": "\\bshutdown\\b",
      "rule_id": "life.shutdown",
      "severity": "info"
    },
    {
      "category": "lifecycle",
      "description_template": "reboot command detected: {match}",
      "event_types": [
        "read",
        "send"
      ],
      "label": "session_lifecycle",
      "pattern": "\\breboot\\b",
      "rule_id": "life.reboot",
      "severity": "info"
    }
  ],
