{
  "cases": [
    {
      "name": "an ordinary run",
      "args": {
        "server": "https://warp.example",
        "port": 8080,
        "token": "t"
      },
      "tunnel_info": {
        "tunnel_id": "t-1",
        "share_url": "https://warp.example/app/inspect/t-1",
        "ws_endpoint": "/tunnel/abc",
        "worker_token": "worker-token"
      },
      "ran": {
        "created": {
          "server": "https://warp.example",
          "display_name": "http:8080",
          "token": "t",
          "target_port": 8080
        },
        "inspect": {
          "ws_endpoint": "wss://warp.example/tunnel/abc",
          "worker_token": "worker-token",
          "target_port": 8080,
          "listen_port": 0,
          "intercept": false,
          "intercept_timeout": 30.0,
          "intercept_timeout_action": "forward"
        }
      },
      "stdout": "Creating tunnel... done (t-1)\nInspecting HTTP traffic on localhost:8080\n  Share: https://warp.example/app/inspect/t-1\nPress Ctrl+C to stop.\n\n",
      "stderr": "",
      "exit_code": null
    },
