<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <Format>cobertura</Format>
          <!-- Pure data tables — exclude from coverage denominator. -->
          <ExcludeByFile>**/UnicodeNormTables.cs,**/UnicodeWidthTables.cs,**/CharsetTables.cs,**/RegexGenerator.g.cs</ExcludeByFile>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
