{
  "name": "provide-uterm-frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json && cp static/* ../../packages/provide-uterm-server/src/provide/terminal/server/frontend/",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "biome lint src/",
    "fix": "biome check --write --unsafe src/"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.12",
    "@vitest/coverage-v8": "4.1.4",
    "jsdom": "29.0.2",
    "typescript": "6.0.2",
    "vite": "8.0.8",
    "vitest": "4.1.4"
  }
}
