{
  "name": "provide-uterm-ts",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "description": "TypeScript port of the provide-uterm terminal session platform",
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "smoke:dist": "node scripts/smoke-dist.mjs",
    "benchmark:control-channel": "npm run build && node dist/control-channel/benchmark.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run",
    "lint": "biome lint src/",
    "fix": "biome check --write --unsafe src/",
    "ensure:pty": "node scripts/ensure-pty-helper.mjs",
    "pretest": "node scripts/ensure-pty-helper.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@noble/hashes": "^2.3.0",
    "node-pty": "^1.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "smol-toml": "^1.7.1",
    "ssh2": "^1.17.0",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/ssh2": "^1.15.5",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.8",
    "jsdom": "^30.0.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.8"
  }
}
