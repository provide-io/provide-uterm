{
 "generator": "packages/provide-uterm-ts/testdata/gen_stream_redaction_golden.py",
 "default_rules": [
  {
   "pattern": "\\b(?:AKIA|ASIA|AROA|AIDA|AGPA|ANPA|ANVA|ASCA)[0-9A-Z]{16}\\b",
   "replacement": "[AWS_ACCESS_KEY_REDACTED]"
  },
  {
   "pattern": "(?i:aws[_ -]?secret[_ -]?access[_ -]?key\\s*[:=]\\s*['\\\"]?[A-Za-z0-9/+=]{40}['\\\"]?)",
   "replacement": "[AWS_SECRET_REDACTED]"
  },
  {
   "pattern": "\\bgh[opusr]_[A-Za-z0-9_]{36,251}\\b",
   "replacement": "[GITHUB_TOKEN_REDACTED]"
  },
  {
   "pattern": "\\bxox[abeprs]-(?:[0-9]+-){2,}[A-Za-z0-9-]{20,}\\b",
   "replacement": "[SLACK_TOKEN_REDACTED]"
  },
  {
   "pattern": "\\beyJ[A-Za-z0-9_-]+\\.eyJ[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\b",
   "replacement": "[JWT_REDACTED]"
  },
  {
   "pattern": "-----BEGIN (?:RSA |DSA |EC |OPENSSH |PGP )?PRIVATE KEY-----[\\s\\S]+?-----END (?:RSA |DSA |EC |OPENSSH |PGP )?PRIVATE KEY-----",
   "replacement": "[PRIVATE_KEY_REDACTED]"
  },
  {
   "pattern": "(?i:\\bauthorization\\s*:\\s*bearer\\s+([A-Za-z0-9._\\-+/=]+))",
   "replacement": "Authorization: Bearer [REDACTED]"
  },
  {
   "pattern": "(?i:\\b(?:password|passwd|pwd)\\s*[:=]\\s*['\\\"]?(\\S{1,128}?)['\\\"]?(?=\\s|$|,|;|&))",
   "replacement": "[PASSWORD_REDACTED]"
  },
  {
   "pattern": "(?i:\\bapi[_-]?key\\s*[:=]\\s*['\\\"]?(\\S{6,128}?)['\\\"]?(?=\\s|$|,|;|&))",
   "replacement": "[API_KEY_REDACTED]"
  },
  {
   "pattern": "(?i:\\btoken\\s*[:=]\\s*['\\\"]?(\\S{8,256}?)['\\\"]?(?=\\s|$|,|;|&))",
   "replacement": "[TOKEN_REDACTED]"
  }
 ],
 "default": [
  {
   "input": "",
   "output": ""
  },
  {
   "input": "just some normal terminal output with no secrets",
   "output": "just some normal terminal output with no secrets"
  },
