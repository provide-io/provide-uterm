@startuml system-overview
title provide-terminal — System Overview & Extensibility Hooks

skinparam backgroundColor #ffffff
skinparam defaultFontColor #333333
skinparam componentBorderColor #d1d5db
skinparam componentBackgroundColor #f3f4f6
skinparam packageBorderColor #d1d5db
skinparam packageBackgroundColor #ffffff
skinparam arrowColor #2563eb
skinparam noteBorderColor #d1d5db
skinparam noteBackgroundColor #f9fafb

skinparam rectangle {
  BorderColor #2563eb
  BackgroundColor #eff6ff
  FontColor #1e40af
}

' --- External Tier (managed/External) ---
rectangle "External External Management Tier" as FLEET #fff7ed {
  note bottom: (External Decision Engine)
}

' --- Core package ---
package "provide-terminal (core)" as CORE {
  [ansi / screen / emulator\nprotocols / detection\ndeckmux / shell / render / replay] as CORE_C
}

' --- Server package ---
package "provide-terminal-server" as SRV {
  [bridge hub / FastAPI / CLI\ntunnel / gateway] as SRV_C
}

' --- Client package ---
package "provide-terminal-client" as CLIENT {
  [HTTP/WS client\ntransports / AI/MCP] as CLIENT_C
}

' --- Platform package ---
package "provide-terminal-platform" as PLAT {
  [PTY / PAM / capture\nmanager] as PLAT_C
}

' --- Edge packages ---
package "provide-terminal-cloudflare" as CF {
  [CF Worker adapter\nDurable Objects / KV] as CF_C
}

package "provide-terminal-frontend" as FE {
  [Browser UI\n(React / Vite)] as FE_C
}

package "provide-terminal-app" as APP {
  [App shell] as APP_C
}

package "provide-telemetry" as TELEM {
  [structured logging\n& DAS schema] as TELEM_C
}

' --- Dependencies ---
TELEM_C <-- CORE_C : required
CORE_C <-- SRV_C : uses
CORE_C <-- CLIENT_C : uses
CORE_C <-- PLAT_C : uses

' --- CF adapter ---
SRV_C <-- CF_C : adapter

' --- Frontend connects via WS ---
FE_C --> SRV_C : WebSocket / REST
FE_C --> CF_C : WebSocket / REST
APP_C --> FE_C : embeds

' --- Extensibility Hooks (extensibility layer) ---
SRV_C --right--> FLEET : **Policy / Auth Hooks**\n(Webhooks)
SRV_C --right--> FLEET : **Discovery**\n(Heartbeat)
SRV_C ..> FLEET : **Telemetry**\n(DAS Events / OTLP)
PLAT_C --right--> FLEET : **Spawn Policy**\n(Webhooks)

@enduml
