# Local Gemini/antigravity CLI state (a symlink to ~/.gemini config, machine-local).
.antigravitycli/

.hypothesis/
.worktrees/

# Build / packaging
build/
dist/
*.egg-info/

# macOS
.DS_Store
._*

# Editor
.idea/
pyrightconfig.json

# Claude Code runtime artifacts (scheduled task lock, local permission overrides)
.claude/

# bfiles bundles (code-context snapshots, not source)
*-bf-*.txt
*-bf.txt
bf-*.txt

# Node / frontend tooling
node_modules/

# CF Worker vendored Python modules (regenerated by pywrangler)
packages/provide-uterm-cloudflare/python_modules/

# Playwright MCP output (screenshots, console logs)
.playwright-mcp/
# Playwright cross-backend "proof" run output (videos + summaries) — regenerable
# test artifacts, not committed.
packages/provide-uterm/tests/playwright/screenshots/backend-proof/
*.png
# But commit the canonical brand images (banner + size ladder).
!docs/images/*.png
.pymutant-state/
mutants/
.pymutant-ledger.json
.pymutant-strict-campaign.json
mutation-score.json
.wrangler
memray-output/
.worktrees/

# Compiled frontend (build artifact — generated by npm run build:frontend).
# The Docker images build it in-image (frontend-build stage); it is NOT committed.
packages/provide-uterm/src/provide/uterm/frontend/
src/provide/uterm/frontend/
packages/provide-uterm-server/src/provide/uterm/server/frontend/

# Demo recordings (generated binary artifacts — regenerate with scripts/record_all_demos.py)
demo/*.mp4
demo/*.webm
demo/**/*.cast
demo/**/*.cast.stderr
demo/**/*.mp4
demo/**/*.webm
demo/**/screenshots/
# Orchestrator output. INDEX.md moved from demo/recordings/ to demo/ when the
# recorder base path was corrected, and the .*-server.{toml,log} pairs are
# per-demo scratch written next to the recordings they configure.
demo/INDEX.md
demo/.*-server.toml
demo/.*-server.log
# Repo-local scratch for manual runs that point a recorder somewhere other than
# demo/. Kept because it costs nothing, but nothing writes here by default:
# record_all_demos.py records into demo/, which is what build_site_manifest.py
# reads. The old wording ("renamed from demo/recordings/") outlived the rename
# and read as if the orchestrator still used a scratch dir — which is exactly
# how its stale BASE_OUT went unnoticed.
demo/.recordings/
# Per-run scratch written by scripts/record_uterm_vnc_demo_video.py into the
# evidence dir (demo/vnc-lab): auto-generated server config, logs, raw Playwright
# captures. Transient — never committed.
demo/vnc-lab/server.toml
demo/vnc-lab/server.log
demo/vnc-lab/video-error.log
demo/vnc-lab/lab-build.log
demo/vnc-lab/storyboard/
demo/vnc-lab/video-raw/
demo/vnc-lab/recordings/
# Nested "turtles" demo per-run scratch (record_uterm_vnc_nested_demo.py).
demo/vnc-lab/nested-server.toml
demo/vnc-lab/nested-server.log
demo/vnc-lab/nested-summary.log
demo/vnc-lab/nested-video-raw/
# Nautilus panels demo per-run scratch (record_uterm_vnc_panels_demo.py).
demo/vnc-lab/panels-server.toml
demo/vnc-lab/panels-server.log
demo/vnc-lab/panels-summary.log
demo/vnc-lab/video-summary.log
demo/vnc-lab/panels-video-raw/
# Tracked exceptions: only the lightweight, non-video assets (poster.png /
# terminal.cast / screenshots/*.png). The mp4/webm recordings are build
# artifacts — regenerated by the recorders — and are NOT committed regardless of
# their trim name; the site deploy fetches them out of band from a GitHub release
# populated by scripts/demos/publish_demo_assets.py. The manifest at
# demo/site-manifest.json enumerates the full asset set —
# see scripts/demos/build_site_manifest.py.
!demo/**/terminal.cast
!demo/**/poster.png
!demo/**/screenshots/
!demo/**/screenshots/*.png
# Top-level hero reel poster (pre-baked first frame, so the deploy runner doesn't
# need ffmpeg). The reel.mp4 video itself is a build artifact and is not tracked.
!demo/reel-poster.png
# Recorder sideband log — asciinema_record redirects the script's stderr
# here so the cast itself is noise-free. Useful for diagnostics, not for git.
demo/**/*.cast.stderr
artifacts/
.worktrees/

# Internal dev-process artifacts (kept in the external archive, not the public repo)
.provide/
docs/superpowers/

# C# port build outputs
packages/provide-uterm-csharp/bin/
packages/provide-uterm-csharp/**/bin/
packages/provide-uterm-csharp/**/obj/
packages/provide-uterm-csharp/coverage-out/

# SQLite artifacts. Kept after the Beads removal: this project genuinely uses
# SQLite (the control-plane token store, the C# port), so un-ignoring *.db
# would start surfacing stray test databases as untracked noise.
*.db

# vitest coverage output. Globbed rather than listed per package: the frontend
# and app configs also set reportsDirectory "./coverage", and only the ts port
# was ignored, so running their coverage targets left an untracked dir behind.
packages/*/coverage/

# TypeScript port: StrykerJS mutation-testing output and sandbox scratch dir
packages/provide-uterm-ts/reports/
packages/provide-uterm-ts/.stryker-tmp/

# Benchmark sweeps (Makefile.bench). A result is only meaningful next to its
# env.json fingerprint and its profile, so local runs are not history --
# see docs/benchmarks/README.md for how to keep one deliberately.
docs/benchmarks/results/

# Scratch directory the CI-parity runner hands to steps that write into
# ${{ runner.temp }} (scripts/ci_parity.py).
/.ci-parity-tmp/
