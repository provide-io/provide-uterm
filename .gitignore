# Demo recordings (generated binary artifacts — regenerate with scripts/record_all_demos.py)
demo/**/*.cast
demo/**/*.mp4
demo/**/*.webm
demo/**/screenshots/
# Repo-local demo recordings generated during manual runs and should not be tracked.
demo/recordings/
# Tracked exceptions: just the files site-uterm-io's deploy actually needs
# (browser_trim.mp4 / poster.png / terminal.cast / screenshots/*.png). Total ~6 MB
# across 15 demos; intermediate build artifacts (raw recordings, per-frame mp4s,
# webms) stay ignored. The manifest at demo/site-manifest.json enumerates
# exactly what gets synced — see scripts/demos/build_site_manifest.py.
!demo/**/browser_trim.mp4
!demo/**/terminal.cast
!demo/**/poster.png
!demo/**/screenshots/
!demo/**/screenshots/*.png
# Top-level hero reel + its pre-baked first-frame poster.
# site-uterm-io's hero element references both via /demo-assets/_hero/;
# sync_uterm_demos.py copies them at build time. The poster is committed
# pre-baked so the deploy runner doesn't need ffmpeg.
!demo/reel.mp4
!demo/reel-poster.png
# Recorder sideband log — asciinema_record redirects the script's stderr
# here so the cast itself is noise-free. Useful for diagnostics, not for git.
demo/**/*.cast.stderr
artifacts/
.worktrees/
