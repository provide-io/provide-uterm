#
# provide-uterm — FastAPI reference server
#
# Build (from repo root):
#   docker build -f docker/Dockerfile.server -t provide-uterm-server .
#
# Run (fails closed until configured):
#   docker run --rm -p 27780:27780 provide-uterm-server
#
# The bundled /etc/uterm/server.toml intentionally contains rejected auth
# placeholders so the image fails closed until configured. Mount a real config:
#   docker run --rm -p 27780:27780 \
#     -v /path/to/my.toml:/etc/uterm/server.toml:ro \
#     provide-uterm-server
#
# The server binds on 0.0.0.0:27780 inside the container.
# Dashboard: http://localhost:27780/app/
# Health:    http://localhost:27780/api/health
# Sessions:  http://localhost:27780/api/sessions
#
# Dependencies are installed by uv into a managed virtualenv (/app/.venv),
# pinned to the committed uv.lock (UV_FROZEN=1) — never into system site-packages.
#
# The browser UI is built IN-IMAGE (frontend-build stage) and is no longer
# committed to the source tree; the Python builder bakes it into the venv via
# setuptools package-data (provide-uterm-server/pyproject.toml -> "frontend/**").
#

# ---- shared build args ------------------------------------------------------
# Node base image tag — keep in sync with .nvmrc (single source of truth for the
# Node major used to build the frontend). Same value is used by Dockerfile.cf.
ARG NODE_IMAGE=node:22-slim
# Canonical location of the compiled frontend inside the SERVER package source
# tree. The server serves these at runtime via
# importlib.resources.files("provide.uterm.server")/"frontend". Defined ONCE here
# and mirrored by Dockerfile.cf so the two images can't drift.
ARG FRONTEND_DIR=packages/provide-uterm-server/src/provide/uterm/server/frontend

# ---- frontend-build stage: compile the browser UI ---------------------------
FROM ${NODE_IMAGE} AS frontend-build

WORKDIR /src

# Copy the npm workspace manifests + lockfile first so `npm ci` is layer-cached
# independently of source changes.
COPY package.json package-lock.json ./
COPY packages/provide-uterm-frontend/package.json packages/provide-uterm-frontend/package.json
COPY packages/provide-uterm-app/package.json packages/provide-uterm-app/package.json
# provide-uterm-app depends on the provide-uterm-ts workspace (it imports
# `provide-uterm-ts/api-routes`), so that manifest must exist for `npm ci` to
# reify the workspace link.
COPY packages/provide-uterm-ts/package.json packages/provide-uterm-ts/package.json

# Reproducible install from the committed lockfile (no re-resolution).
# --ignore-scripts: provide-uterm-ts pulls in node-pty, whose install script
# compiles a native addon via node-gyp. This slim image has no python3/g++, and
# a browser bundle never loads a native PTY — so skip lifecycle scripts rather
# than dragging a C toolchain into a frontend build stage. `npm ci` still
# validates package.json against the committed lockfile.
RUN npm ci --ignore-scripts

# Bring in the rest of the workspace needed to build (frontend/app/ts source +
# build scripts; the build emits into the server package dir under /src).
COPY scripts/ scripts/
COPY packages/provide-uterm-frontend/ packages/provide-uterm-frontend/
COPY packages/provide-uterm-app/ packages/provide-uterm-app/
COPY packages/provide-uterm-ts/ packages/provide-uterm-ts/

# Compile widgets (tsc + copy) and the app bundle (vite build). Output lands in
# ${FRONTEND_DIR} (the server package dir) under /src. Also publishes
# vite-manifest.json (package-data-safe; setuptools omits .vite/).
RUN npm run build:frontend

# ---- builder stage: resolve + install into a uv-managed venv ----------------
FROM python:3.11-slim AS builder

ARG FRONTEND_DIR

ENV PYTHONUNBUFFERED=1

# Pull in the latest base-image security patches (Debian point releases ship
# fixes for libcap2 / libsystemd0 / libudev1 that the trailing python:3.11-slim
# digest doesn't yet pick up). Required to keep the Trivy HIGH/CRITICAL gate
# green even between python:3.11-slim digest pins.
RUN apt-get update \
    && apt-get upgrade -y --no-install-recommends \
    && rm -rf /var/lib/apt/lists/*

# Pin the uv toolchain via the official image instead of bootstrapping it with
# system pip. Pin to a digest for full reproducibility when you cut a release.
COPY --from=ghcr.io/astral-sh/uv:0.11.33 /uv /uvx /bin/

# uv installs into the venv at /app/.venv using the base image's interpreter (so
# the venv is portable to the runtime stage, which shares the base), pinned to
# uv.lock (UV_FROZEN=1) — never system site-packages (no `uv pip install --system`).
ENV UV_PROJECT_ENVIRONMENT=/app/.venv \
    UV_PYTHON_PREFERENCE=only-system \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_FROZEN=1

WORKDIR /app

# Copy workspace root metadata (incl. uv.lock — now actually consumed) plus the
# `uv sync` reads the WHOLE workspace, so ALL 6 uv workspace members
# ([tool.uv.workspace] in the root pyproject) must be present on disk — even
# the ones not installed — or the frozen sync errors on a missing member.
# server[all] in particular pulls provide-uterm-annotation (a workspace source).
COPY pyproject.toml uv.lock README.md ./
COPY packages/provide-uterm/ packages/provide-uterm/
COPY packages/provide-uterm-client/ packages/provide-uterm-client/
COPY packages/provide-uterm-server/ packages/provide-uterm-server/
COPY packages/provide-uterm-annotation/ packages/provide-uterm-annotation/
COPY packages/provide-uterm-cloudflare/ packages/provide-uterm-cloudflare/
COPY packages/provide-uterm-platform/ packages/provide-uterm-platform/

# Drop the compiled frontend into the server package source tree BEFORE the
# install. setuptools' package-data ("frontend/**") bakes it into the venv during
# the --no-editable build, so the runtime stage needs only the venv. The frontend
# is no longer committed to git — it comes solely from the frontend-build stage.
COPY --from=frontend-build /src/${FRONTEND_DIR}/ ${FRONTEND_DIR}/

# Install the server with all extras (pulls core + client + annotation workspace
# deps AND core's `emulator` dep pyte, now declared in server[all], from the
# lock) NON-editable so the members are baked into /app/.venv and the runtime
# stage needs only the venv. No side-channel `uv pip install pyte` — that
# escaped UV_FROZEN (unpinned/hash-unverified); pyte is now in uv.lock.
RUN uv sync --frozen --no-dev --no-editable --package provide-uterm-server --extra all

# setuptools package-data globs historically drop leading-dot dirs; ensure the
# Vite manifest is present under the installed package regardless. Path must
# match FRONTEND_DIR (ARG above) — keep in sync when that ARG changes.
RUN /app/.venv/bin/python - <<'PY'
from pathlib import Path
import shutil
import provide.uterm.server as s

src = Path("packages/provide-uterm-server/src/provide/uterm/server/frontend/.vite")
if not src.is_dir():
    raise SystemExit(f"frontend .vite missing at {src.resolve()}")
dst = Path(s.__file__).resolve().parent / "frontend" / ".vite"
dst.mkdir(parents=True, exist_ok=True)
for item in src.iterdir():
    target = dst / item.name
    if item.is_dir():
        shutil.copytree(item, target, dirs_exist_ok=True)
    else:
        shutil.copy2(item, target)
manifest = dst / "manifest.json"
if not manifest.is_file():
    raise SystemExit(f"manifest not installed at {manifest}")
print(f"installed vite assets under {dst}")
PY

# Strip build backends from the runtime venv. uv resolves the build deps
# (pip / setuptools / wheel / jaraco.* / etc.) into the env to build the
# --no-editable workspace wheels, but they are NOT needed to RUN the server and
# Trivy flags them (e.g. wheel / jaraco.context HIGH CVEs). Remove them so the
# runtime image's venv carries only runtime-required packages.
RUN uv pip uninstall --python /app/.venv/bin/python \
        pip setuptools wheel \
    ; rm -rf /app/.venv/lib/python*/site-packages/jaraco* \
             /app/.venv/lib/python*/site-packages/pkg_resources \
             /app/.venv/lib/python*/site-packages/_distutils_hack \
             /app/.venv/lib/python*/site-packages/distutils-precedence.pth \
             /app/.venv/bin/pip* \
             /app/.venv/bin/wheel*

# ---- runtime stage ----------------------------------------------------------
FROM python:3.11-slim AS runtime

ENV PYTHONUNBUFFERED=1 \
    PATH="/app/.venv/bin:$PATH"

RUN apt-get update \
    && apt-get upgrade -y --no-install-recommends \
    && rm -rf /var/lib/apt/lists/*

# Strip build tooling from the base image's SYSTEM site-packages. python:3.11-slim
# ships pip / setuptools / wheel in /usr/local/lib/python3.11/site-packages — and
# setuptools vendors its own copy of jaraco.context + wheel under _vendor/. The
# server runs entirely from /app/.venv (which uv builds with isolation, so it
# carries none of this), making the system build tooling dead weight that Trivy
# flags (wheel CVE-2026-24049, vendored jaraco.context CVE-2026-23949). Remove it
# so the runtime image carries only runtime-required packages. The strip verifies
# itself at site-packages depth 1 only — nested METADATA files named WHEEL (e.g.
# packaging-*.dist-info/WHEEL) are PEP 427 metadata, not the wheel package.
RUN rm -rf /usr/local/lib/python3.11/site-packages/setuptools* \
           /usr/local/lib/python3.11/site-packages/pkg_resources* \
           /usr/local/lib/python3.11/site-packages/_distutils_hack* \
           /usr/local/lib/python3.11/site-packages/distutils-precedence.pth \
           /usr/local/lib/python3.11/site-packages/wheel* \
           /usr/local/lib/python3.11/site-packages/pip* \
           /usr/local/bin/pip* /usr/local/bin/wheel* \
    && ! find /usr/local/lib/python3.11/site-packages -mindepth 1 -maxdepth 1 \
         \( -iname 'setuptools*' -o -iname 'wheel*' -o -iname 'jaraco*' -o -iname 'pip*' \) \
         -print | grep -q .

WORKDIR /app

# Copy the uv-managed venv. With --no-editable the workspace packages (incl. the
# baked-in frontend assets) are inside the venv's site-packages, so no source
# tree is needed at runtime. The venv's interpreter is the base image's python,
# present in this stage too.
COPY --from=builder /app/.venv /app/.venv

# Default config is fail-closed: JWT/header secrets are placeholders rejected
# by the server. Override via directory mount of /etc/uterm or a file bind:
#   -v /path/to/dir:/etc/uterm:ro   (dir must contain server.toml)
COPY docker/server.toml /etc/uterm/server.toml

EXPOSE 27780

CMD ["uterm", "server", "--config", "/etc/uterm/server.toml", "--host", "0.0.0.0", "--port", "27780"]
