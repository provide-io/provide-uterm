#
# provide-uterm — FastAPI reference server
#
# Build (from repo root):
#   docker build -f docker/Dockerfile.server -t provide-uterm-server .
#
# Run (fails closed until configured):
#   docker run --rm -p 27780:27780 provide-uterm-server
#
# The bundled /config/server.toml intentionally contains rejected auth
# placeholders so the image fails closed until configured. Mount a real config:
#   docker run --rm -p 27780:27780 \
#     -v /path/to/my.toml:/config/server.toml:ro \
#     provide-uterm-server
#
# The server binds on 0.0.0.0:27780 inside the container.
# Dashboard: http://localhost:27780/app/
# Health:    http://localhost:27780/api/health
# Sessions:  http://localhost:27780/api/sessions
#

FROM python:3.14-slim

# Keeps Python from buffering stdout/stderr
ENV PYTHONUNBUFFERED=1

# Pull in the latest base-image security patches (Debian point releases ship
# fixes for libcap2 / libsystemd0 / libudev1 that the trailing python:3.11-slim
# digest doesn't yet pick up). Required to keep the Trivy HIGH/CRITICAL gate
# green even between python:3.11-slim digest pins.
RUN apt-get update \
    && apt-get upgrade -y --no-install-recommends \
    && rm -rf /var/lib/apt/lists/*

# Bring pip's bundled wheel / setuptools (which vendors jaraco.context) up to
# the post-fix versions before uv consumes them.
RUN pip install --no-cache-dir --upgrade "pip>=25.2" "setuptools>=80.10.0" "wheel>=0.46.2" \
    && pip install --no-cache-dir uv

WORKDIR /app

# Copy workspace root metadata
COPY pyproject.toml uv.lock README.md ./

# Copy core, client (workspace dependency of server), and server packages.
# provide-uterm-server requires provide-uterm-client, which is declared as a
# workspace member in the root pyproject — uv refuses to resolve the install
# if the workspace member directory is missing from the build context.
COPY packages/provide-uterm/ packages/provide-uterm/
COPY packages/provide-uterm-client/ packages/provide-uterm-client/
COPY packages/provide-uterm-server/ packages/provide-uterm-server/

# Install the server with all extras
RUN uv pip install --system "./packages/provide-uterm[emulator]" "./packages/provide-uterm-server[all]"

# Default config is fail-closed: JWT/header secrets are placeholders rejected
# by the server. Override via: -v /path/to/config.toml:/config/server.toml:ro
COPY docker/server.toml /config/server.toml

EXPOSE 27780

CMD ["uterm", "server", "--config", "/config/server.toml", "--host", "0.0.0.0", "--port", "27780"]
