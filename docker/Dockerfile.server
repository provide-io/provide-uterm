#
# provide-uterm — FastAPI reference server
#
# Build (from repo root):
#   docker build -f docker/Dockerfile.server -t provide-uterm-server .
#
# Run (fails closed until configured):
#   docker run --rm -p 27780:27780 provide-uterm-server
#
# The bundled /config/server.toml intentionally contains rejected auth
# placeholders so the image fails closed until configured. Mount a real config:
#   docker run --rm -p 27780:27780 \
#     -v /path/to/my.toml:/config/server.toml:ro \
#     provide-uterm-server
#
# The server binds on 0.0.0.0:27780 inside the container.
# Dashboard: http://localhost:27780/app/
# Health:    http://localhost:27780/api/health
# Sessions:  http://localhost:27780/api/sessions
#
# Dependencies are installed by uv into a managed virtualenv (/app/.venv),
# pinned to the committed uv.lock (UV_FROZEN=1) — never into system site-packages.
#

# ---- builder stage: resolve + install into a uv-managed venv ----------------
FROM python:3.11-slim AS builder

ENV PYTHONUNBUFFERED=1

# Pull in the latest base-image security patches (Debian point releases ship
# fixes for libcap2 / libsystemd0 / libudev1 that the trailing python:3.11-slim
# digest doesn't yet pick up). Required to keep the Trivy HIGH/CRITICAL gate
# green even between python:3.11-slim digest pins.
RUN apt-get update \
    && apt-get upgrade -y --no-install-recommends \
    && rm -rf /var/lib/apt/lists/*

# Pin the uv toolchain via the official image instead of bootstrapping it with
# system pip. Pin to a digest for full reproducibility when you cut a release.
COPY --from=ghcr.io/astral-sh/uv:0.11.16 /uv /uvx /bin/

# uv installs into the venv at /app/.venv using the base image's interpreter (so
# the venv is portable to the runtime stage, which shares the base), pinned to
# uv.lock (UV_FROZEN=1) — never system site-packages (no `uv pip install --system`).
ENV UV_PROJECT_ENVIRONMENT=/app/.venv \
    UV_PYTHON_PREFERENCE=only-system \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_FROZEN=1

WORKDIR /app

# Copy workspace root metadata (incl. uv.lock — now actually consumed) plus the
# core, client (workspace dependency of server) and server packages.
COPY pyproject.toml uv.lock README.md ./
COPY packages/provide-uterm/ packages/provide-uterm/
COPY packages/provide-uterm-client/ packages/provide-uterm-client/
COPY packages/provide-uterm-server/ packages/provide-uterm-server/

# Install the server with all extras (pulls core + client workspace deps from
# the lock), then add core's `emulator` dependency (pyte) which the screen
# renderer imports. NEEDS-BUILD-VALIDATION: confirm the resulting /app/.venv
# matches the previous `[emulator]`/`[all]` surface and exposes the `uterm` CLI.
RUN uv sync --no-dev --package provide-uterm-server --extra all \
    && uv pip install --python /app/.venv pyte

# ---- runtime stage ----------------------------------------------------------
FROM python:3.11-slim AS runtime

ENV PYTHONUNBUFFERED=1 \
    PATH="/app/.venv/bin:$PATH"

RUN apt-get update \
    && apt-get upgrade -y --no-install-recommends \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy the uv-managed venv and the (editable-installed) workspace packages it
# references. The venv's interpreter is the base image's python, present in
# this stage too, so the venv is fully functional.
COPY --from=builder /app/.venv /app/.venv
COPY --from=builder /app/packages /app/packages

# Default config is fail-closed: JWT/header secrets are placeholders rejected
# by the server. Override via: -v /path/to/config.toml:/config/server.toml:ro
COPY docker/server.toml /config/server.toml

EXPOSE 27780

CMD ["uterm", "server", "--config", "/config/server.toml", "--host", "0.0.0.0", "--port", "27780"]
