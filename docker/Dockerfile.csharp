#
# provide-uterm — C# language server image (.NET 10)
#
# Build (from repo root):
#   docker build -f docker/Dockerfile.csharp -t provide-uterm-server-csharp .
#
# Run (fails closed until a real config is mounted — same as Dockerfile.server):
#   docker run --rm -p 27782:27780 provide-uterm-server-csharp
#   docker run --rm -p 27782:27780 \
#     -v /path/to/my.toml:/etc/uterm/server.toml:ro \
#     provide-uterm-server-csharp
#
# MCP is not shipped for C# (operator de-scope). Server + CLI only.
# Browser SPA is baked at /app/frontend (same Vite build as Python image).
#

ARG SDK_IMAGE=mcr.microsoft.com/dotnet/sdk:10.0
ARG RUNTIME_IMAGE=mcr.microsoft.com/dotnet/aspnet:10.0
ARG NODE_IMAGE=node:22-slim

# ---- frontend-build: same Vite artifacts as Dockerfile.server ---------------
FROM ${NODE_IMAGE} AS frontend-build

WORKDIR /src
COPY package.json package-lock.json ./
COPY packages/provide-uterm-frontend/package.json packages/provide-uterm-frontend/package.json
COPY packages/provide-uterm-app/package.json packages/provide-uterm-app/package.json
# provide-uterm-app depends on the provide-uterm-ts workspace; --ignore-scripts
# skips node-pty's node-gyp build. See Dockerfile.server for the rationale.
COPY packages/provide-uterm-ts/package.json packages/provide-uterm-ts/package.json
RUN npm ci --ignore-scripts
COPY scripts/ scripts/
COPY packages/provide-uterm-frontend/ packages/provide-uterm-frontend/
COPY packages/provide-uterm-app/ packages/provide-uterm-app/
COPY packages/provide-uterm-ts/ packages/provide-uterm-ts/
RUN npm run build:frontend

# ---- build -----------------------------------------------------------------
FROM ${SDK_IMAGE} AS build

RUN apt-get update && apt-get install -y clang zlib1g-dev

WORKDIR /src

COPY packages/provide-telemetry/ packages/provide-telemetry/
COPY packages/provide-uterm-csharp/ packages/provide-uterm-csharp/
# SelfContained=false, which the csproj uses to switch native AOT and trimming
# OFF (see the PublishAot/PublishTrimmed conditions in Uterm.csproj).
#
# This image cannot be AOT-published. ASP.NET minimal APIs build their request
# delegates through RequestDelegateFactory, which needs JSON metadata that AOT
# trimming removes, so EVERY route — not just one — answered 500 with:
#   System.NotSupportedException: JsonTypeInfo metadata for type
#   'Task`1[IResult]' was not provided by TypeInfoResolver of type '[]'
# thrown while constructing the endpoints. Making the container AOT-clean means
# source-generating JSON contexts across the whole server surface; running
# framework-dependent is the supported path and is what RUNTIME_IMAGE was
# always declared for.
RUN dotnet publish packages/provide-uterm-csharp/cmd/Uterm/Uterm.csproj -c Release -o /app/publish \
    -p:SelfContained=false \
    /p:UseAppHost=true

# ---- runtime ---------------------------------------------------------------
# aspnet:10.0 — the framework-dependent publish above needs the .NET runtime
# present. Two earlier startup failures came from a distroless base, and the
# second was hidden behind the first:
#   1. glibc: an AOT binary links the BUILD image's glibc, and sdk:10.0 is
#      Debian 13 (>= 2.38) while cc-debian12 ships 2.36 —
#        ./uterm: /lib/x86_64-linux-gnu/libm.so.6: version `GLIBC_2.38' not found
#   2. ICU: distroless/cc carries no libicu, and .NET fails fast without it —
#        Process terminated. Couldn't find a valid ICU package installed
# Both are moot now: this image tracks the SDK's distro and ships both.
FROM ${RUNTIME_IMAGE} AS runtime

WORKDIR /app

# The whole publish directory, not just the apphost: a framework-dependent
# publish is the apphost PLUS its managed assemblies, and copying the single
# file leaves an executable with nothing to run.
COPY --from=build /app/publish/ ./
# Baked SPA/static assets (hijack.html, terminal.html, assets/, vite-manifest.json)
COPY --from=frontend-build \
    /src/packages/provide-uterm-server/src/provide/uterm/server/frontend/ \
    /app/frontend/
COPY docker/server.toml /etc/uterm/server.toml

EXPOSE 27780
USER 65532:65532

ENV ASPNETCORE_URLS=http://0.0.0.0:27780 \
    UTERM_FRONTEND_DIR=/app/frontend

ENTRYPOINT ["./uterm", "server", "--config", "/etc/uterm/server.toml", "--host", "0.0.0.0", "--port", "27780"]
