#
# provide-terminal-cloudflare — pywrangler dev server
#
# Build (from repo root):
#   docker build -f docker/Dockerfile.cf -t provide-terminal-cf .
#
# Run (dev mode, AUTH_MODE=dev):
#   docker run --rm -p 27788:27788 provide-terminal-cf
#
# Run with a .dev.vars override:
#   docker run --rm -p 27788:27788 \
#     -v /path/to/.dev.vars:/app/packages/provide-terminal-cloudflare/.dev.vars:ro \
#     provide-terminal-cf
#
# The worker dev server binds on 0.0.0.0:27788 inside the container.
# Health:   http://localhost:27788/api/health
# Sessions: http://localhost:27788/api/sessions
#
# NOTE: wrangler dev performs KV/DO isolation using local SQLite storage.
# State persists in the container's /tmp — it is NOT written to Cloudflare.
#

FROM node:20-slim

# Install Python 3.11 and uv
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3.11 python3.11-dev curl ca-certificates \
    && curl -LsSf https://astral.sh/uv/install.sh | sh \
    && rm -rf /var/lib/apt/lists/*

ENV PATH="/root/.local/bin:$PATH"
ENV PYTHONUNBUFFERED=1

# Install wrangler CLI (required by pywrangler)
RUN npm install -g wrangler@latest

WORKDIR /app

# Copy full workspace so uv can resolve the lockfile
COPY pyproject.toml uv.lock README.md ./
COPY packages/provide-terminal/ packages/provide-terminal/
COPY packages/provide-terminal-cloudflare/ packages/provide-terminal-cloudflare/

WORKDIR /app/packages/provide-terminal-cloudflare

# Install CF package dependencies including dev extras (workers-py provides pywrangler)
RUN uv sync --extra dev

# Populate the CF package's static dir with compiled frontend assets so the
# worker can serve the UI without needing the provide-terminal package at runtime.
RUN cp -r /app/packages/provide-terminal/src/provide/terminal/frontend/. \
        src/provide_terminal_cloudflare/ui/static/

EXPOSE 27788

# pywrangler dev: syncs vendor deps then starts wrangler dev
CMD ["uv", "run", "pywrangler", "dev", "--port", "27788", "--ip", "0.0.0.0"]
