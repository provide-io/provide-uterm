#
# provide-uterm-cloudflare — pywrangler dev server
#
# Build (from repo root):
#   docker build -f docker/Dockerfile.cf -t provide-uterm-cf .
#
# Run (local Cloudflare dev mode):
#   docker run --rm -p 27788:27788 provide-uterm-cf
#
# Run with a .dev.vars override:
#   docker run --rm -p 27788:27788 \
#     -v /path/to/.dev.vars:/app/packages/provide-uterm-cloudflare/.dev.vars:ro \
#     provide-uterm-cf
#
# The worker dev server binds on 0.0.0.0:27788 inside the container.
# Health:   http://localhost:27788/api/health
# Sessions: http://localhost:27788/api/sessions
#
# NOTE: wrangler dev performs KV/DO isolation using local SQLite storage.
# State persists in the container's /tmp — it is NOT written to Cloudflare.
#
# The browser UI is built IN-IMAGE (frontend-build stage) and is no longer
# committed to the source tree; the worker's static dir is populated by a
# COPY --from=frontend-build below.
#

# ---- shared build args ------------------------------------------------------
# Node base image tag — keep in sync with .nvmrc (single source of truth for the
# Node major used to build the frontend). Same value is used by Dockerfile.server.
ARG NODE_IMAGE=node:22-slim
# Canonical location of the compiled frontend inside the SERVER package source
# tree (where `npm run build:frontend` emits). Defined ONCE here and mirrored by
# Dockerfile.server so the two images can't drift.
ARG FRONTEND_DIR=packages/provide-uterm-server/src/provide/uterm/server/frontend

# ---- frontend-build stage: compile the browser UI ---------------------------
FROM ${NODE_IMAGE} AS frontend-build

WORKDIR /src

# Copy the npm workspace manifests + lockfile first so `npm ci` is layer-cached
# independently of source changes.
COPY package.json package-lock.json ./
COPY packages/provide-uterm-frontend/package.json packages/provide-uterm-frontend/package.json
COPY packages/provide-uterm-app/package.json packages/provide-uterm-app/package.json
# provide-uterm-app depends on the provide-uterm-ts workspace, so its manifest
# must exist for `npm ci` to reify the workspace link (mirrors Dockerfile.server).
COPY packages/provide-uterm-ts/package.json packages/provide-uterm-ts/package.json

# Reproducible install from the committed lockfile (no re-resolution).
# --ignore-scripts skips node-pty's node-gyp build (pulled in via
# provide-uterm-ts); this slim image has no C toolchain and a browser bundle
# never loads a native PTY. See Dockerfile.server for the full rationale.
RUN npm ci --ignore-scripts

# Bring in the rest of the workspace needed to build (frontend/app/ts source +
# build scripts; the build emits into the server package dir under /src).
COPY scripts/ scripts/
COPY packages/provide-uterm-frontend/ packages/provide-uterm-frontend/
COPY packages/provide-uterm-app/ packages/provide-uterm-app/
COPY packages/provide-uterm-ts/ packages/provide-uterm-ts/

# Compile widgets (tsc + copy) and the app bundle (vite build). Output lands in
# ${FRONTEND_DIR} under /src.
RUN npm run build:frontend

# ---- runtime stage ----------------------------------------------------------
FROM node:26-slim

ARG FRONTEND_DIR

# Install Python + uv. The node:26-slim base is Debian trixie, whose `python3`
# is 3.13 (there is no `python3.11` apt package on this base) — that satisfies
# the project's requires-python >=3.11, and uv resolves the lock against it.
# `apt-get upgrade` pulls the base's latest security point-releases (libssl /
# libc / etc.) so the Trivy HIGH/CRITICAL gate isn't tripped by an unpatched
# base — same rationale as Dockerfile.server's builder/runtime stages.
RUN apt-get update \
    && apt-get upgrade -y --no-install-recommends \
    && apt-get install -y --no-install-recommends \
        python3 python3-dev curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# uv from the pinned official image — NOT an unpinned `curl ... install.sh | sh`
# (supply-chain). Mirrors Dockerfile.server so both images use the same auditable,
# reproducible uv binary. Floor is uv 0.11.30: earlier builds statically link
# quinn-proto 0.11.14, which Trivy's HIGH/CRITICAL gate flags as
# GHSA-4w2j-m93h-cj5j (remote memory exhaustion). Unlike Dockerfile.server,
# which only needs uv in its discarded builder stage, this image ships uv in the
# runtime layer because its CMD is `uv run pywrangler`, so the scanner sees it.
COPY --from=ghcr.io/astral-sh/uv:0.11.33 /uv /uvx /bin/

ENV PYTHONUNBUFFERED=1
# Pin every `uv sync` / `uv run` in this image to the committed uv.lock (no
# in-image re-resolution), including the `uv run pywrangler` CMD below.
ENV UV_FROZEN=1

# Install wrangler CLI (required by pywrangler) into a dedicated prefix so we can
# force a patched undici via an npm override. wrangler bundles miniflare, which
# resolves undici 6.26.0 — CVE-2026-12151 (HIGH: denial of service via unbounded
# memory), fixed in 6.27.0. The override pins undici to >=6.27.0,<7 across the
# dependency tree (Trivy's HIGH/CRITICAL gate flags the bundled 6.26.0).
#
# The wrangler version is pinned to the exact one the repo's package.json
# depends on. It was `wrangler@latest`, which made each image build resolve a
# fresh dependency tree, so the CVEs the scan reported changed on their own
# between builds with no commit in between — the run that prompted this pin
# failed on brace-expansion (CVE-2026-13149, CVE-2026-14257) and tar
# (CVE-2026-59873 CRITICAL, CVE-2026-59874), neither of which 4.118.0 pulls in
# at all. Keep this in sync with package.json when bumping wrangler.
#
# The wrangler binary is symlinked onto PATH so pywrangler resolves it exactly
# as a global install would.
RUN mkdir -p /opt/wrangler \
    && cd /opt/wrangler \
    && printf '{"name":"wrangler-host","private":true,"overrides":{"undici":"^6.27.0"}}\n' > package.json \
    && npm install --no-audit --no-fund wrangler@4.118.0 \
    && ln -sf /opt/wrangler/node_modules/.bin/wrangler /usr/local/bin/wrangler \
    && wrangler --version

# node:26-slim's bundled npm (11.19.0 as of this writing) vendors its own copies
# of several packages that Trivy's HIGH/CRITICAL gate flags. npm is a build-time
# tool here — the worker runtime never invokes it — but Trivy scans it anyway,
# and an npm `overrides` entry cannot reach npm's *bundled* tree, so each one has
# to be replaced in place. All four replacements are semver-compatible patches:
#   undici           6.26.0 -> 6.27.0   CVE-2026-12151 HIGH     unbounded memory
#   brace-expansion  5.0.6  -> 5.0.9    CVE-2026-13149 HIGH     exponential-time
#                                       CVE-2026-14257 HIGH     (needs >= 5.0.8)
#                                       CVE-2026-69152 HIGH     unbounded arrays
#                                       (needs >= 5.0.9; this one landed after
#                                       the 5.0.8 pin, with no commit of ours in
#                                       between — Trivy's database updates daily,
#                                       so a pinned image goes red on its own)
#   ip-address       10.2.0 -> 10.5.0   CVE-2026-69192 HIGH     inconsistent
#                                       parsing -> SSRF (needs >= 10.3.1; pinned
#                                       to the current latest rather than the
#                                       advisory floor, for the same
#                                       daily-database reason as the 5.0.8 ->
#                                       5.0.9 churn above). ip-address 10.x has
#                                       no dependencies of its own, so the
#                                       in-place swap pulls in no new tree.
#   tar              7.5.16 -> 7.5.22   CVE-2026-59873 CRITICAL gzip-bomb DoS
#                                       CVE-2026-59874 HIGH     malformed header
#                                       CVE-2026-73566 HIGH     long-path DoS
#                                       (needs >= 7.5.21; the 7.5.19 pin went
#                                       red on its own three weeks later, the
#                                       third time this block has been bumped
#                                       with no commit of ours in between.
#                                       Pinned to current latest, as ip-address
#                                       above is, for the same reason.)
# Every tarball is fetched BEFORE anything is replaced: `npm pack` itself runs on
# npm's bundled tar, so swapping tar mid-loop would pull the implementation out
# from under the remaining downloads. The trailing `npm --version` is a smoke
# check — replacing npm's own dependencies could break npm, and nothing later in
# this build invokes it, so without this the damage would ship undetected.
RUN set -e \
    && NM=/usr/local/lib/node_modules/npm/node_modules \
    && t="$(mktemp -d)" && cd "$t" \
    && npm pack undici@6.27.0 brace-expansion@5.0.9 ip-address@10.5.0 tar@7.5.22 >/dev/null \
    && for pkg in undici brace-expansion ip-address tar; do \
         mkdir -p "unpack-$pkg" \
         && tar xzf "$pkg"-*.tgz -C "unpack-$pkg" \
         && rm -rf "${NM:?}/$pkg" \
         && mv "unpack-$pkg/package" "$NM/$pkg"; \
       done \
    && cd / && rm -rf "$t" \
    && for pkg in undici brace-expansion ip-address tar; do \
         node -e "console.log('npm-bundled $pkg ->', require('$NM/$pkg/package.json').version)"; \
       done \
    && npm --version

WORKDIR /app

# Copy the full uv workspace. A frozen `uv sync` reads every member declared in
# [tool.uv.workspace], so all 6 Python members must be present on disk (even the
# ones not installed here) or the sync errors on a missing workspace member.
COPY pyproject.toml uv.lock README.md ./
COPY packages/provide-uterm/ packages/provide-uterm/
COPY packages/provide-uterm-cloudflare/ packages/provide-uterm-cloudflare/
COPY packages/provide-uterm-client/ packages/provide-uterm-client/
COPY packages/provide-uterm-server/ packages/provide-uterm-server/
COPY packages/provide-uterm-annotation/ packages/provide-uterm-annotation/
COPY packages/provide-uterm-platform/ packages/provide-uterm-platform/

WORKDIR /app/packages/provide-uterm-cloudflare

# Install CF package dependencies including dev extras (workers-py provides
# pywrangler) from the committed lock (UV_FROZEN=1 above).
RUN uv sync --frozen --extra dev

# Populate the CF package's static dir with the compiled frontend assets so the
# worker can serve the UI at runtime. The assets come straight from the
# frontend-build stage (built in-image, not committed to git). The source path
# (${FRONTEND_DIR}) is the canonical build-output dir shared with Dockerfile.server.
RUN mkdir -p src/provide_uterm_cloudflare/ui/static
COPY --from=frontend-build /src/${FRONTEND_DIR}/ \
        src/provide_uterm_cloudflare/ui/static/

EXPOSE 27788

# pywrangler dev: syncs vendor deps then starts wrangler dev
CMD ["uv", "run", "pywrangler", "dev", "--port", "27788", "--ip", "0.0.0.0"]
