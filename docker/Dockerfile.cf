#
# provide-uterm-cloudflare — pywrangler dev server
#
# Build (from repo root):
#   docker build -f docker/Dockerfile.cf -t provide-uterm-cf .
#
# Run (local Cloudflare dev mode):
#   docker run --rm -p 27788:27788 provide-uterm-cf
#
# Run with a .dev.vars override:
#   docker run --rm -p 27788:27788 \
#     -v /path/to/.dev.vars:/app/packages/provide-uterm-cloudflare/.dev.vars:ro \
#     provide-uterm-cf
#
# The worker dev server binds on 0.0.0.0:27788 inside the container.
# Health:   http://localhost:27788/api/health
# Sessions: http://localhost:27788/api/sessions
#
# NOTE: wrangler dev performs KV/DO isolation using local SQLite storage.
# State persists in the container's /tmp — it is NOT written to Cloudflare.
#
# The browser UI is built IN-IMAGE (frontend-build stage) and is no longer
# committed to the source tree; the worker's static dir is populated by a
# COPY --from=frontend-build below.
#

# ---- shared build args ------------------------------------------------------
# Node base image tag — keep in sync with .nvmrc (single source of truth for the
# Node major used to build the frontend). Same value is used by Dockerfile.server.
ARG NODE_IMAGE=node:20-slim
# Canonical location of the compiled frontend inside the SERVER package source
# tree (where `npm run build:frontend` emits). Defined ONCE here and mirrored by
# Dockerfile.server so the two images can't drift.
ARG FRONTEND_DIR=packages/provide-uterm-server/src/provide/uterm/server/frontend

# ---- frontend-build stage: compile the browser UI ---------------------------
FROM ${NODE_IMAGE} AS frontend-build

WORKDIR /src

# Copy the npm workspace manifests + lockfile first so `npm ci` is layer-cached
# independently of source changes.
COPY package.json package-lock.json ./
COPY packages/provide-uterm-frontend/package.json packages/provide-uterm-frontend/package.json
COPY packages/provide-uterm-app/package.json packages/provide-uterm-app/package.json

# Reproducible install from the committed lockfile (no re-resolution).
RUN npm ci

# Bring in the rest of the workspace needed to build (frontend/app source +
# build scripts; the build emits into the server package dir under /src).
COPY scripts/ scripts/
COPY packages/provide-uterm-frontend/ packages/provide-uterm-frontend/
COPY packages/provide-uterm-app/ packages/provide-uterm-app/

# Compile widgets (tsc + copy) and the app bundle (vite build). Output lands in
# ${FRONTEND_DIR} under /src.
RUN npm run build:frontend

# ---- runtime stage ----------------------------------------------------------
FROM node:26-slim

ARG FRONTEND_DIR

# Install Python + uv. The node:26-slim base is Debian trixie, whose `python3`
# is 3.13 (there is no `python3.11` apt package on this base) — that satisfies
# the project's requires-python >=3.11, and uv resolves the lock against it.
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 python3-dev curl ca-certificates \
    && curl -LsSf https://astral.sh/uv/install.sh | sh \
    && rm -rf /var/lib/apt/lists/*

ENV PATH="/root/.local/bin:$PATH"
ENV PYTHONUNBUFFERED=1
# Pin every `uv sync` / `uv run` in this image to the committed uv.lock (no
# in-image re-resolution), including the `uv run pywrangler` CMD below.
ENV UV_FROZEN=1

# Install wrangler CLI (required by pywrangler)
RUN npm install -g wrangler@latest

WORKDIR /app

# Copy the full uv workspace. A frozen `uv sync` reads every member declared in
# [tool.uv.workspace], so all 6 Python members must be present on disk (even the
# ones not installed here) or the sync errors on a missing workspace member.
COPY pyproject.toml uv.lock README.md ./
COPY packages/provide-uterm/ packages/provide-uterm/
COPY packages/provide-uterm-cloudflare/ packages/provide-uterm-cloudflare/
COPY packages/provide-uterm-client/ packages/provide-uterm-client/
COPY packages/provide-uterm-server/ packages/provide-uterm-server/
COPY packages/provide-uterm-annotation/ packages/provide-uterm-annotation/
COPY packages/provide-uterm-platform/ packages/provide-uterm-platform/

WORKDIR /app/packages/provide-uterm-cloudflare

# Install CF package dependencies including dev extras (workers-py provides
# pywrangler) from the committed lock (UV_FROZEN=1 above).
RUN uv sync --frozen --extra dev

# Populate the CF package's static dir with the compiled frontend assets so the
# worker can serve the UI at runtime. The assets come straight from the
# frontend-build stage (built in-image, not committed to git). The source path
# (${FRONTEND_DIR}) is the canonical build-output dir shared with Dockerfile.server.
RUN mkdir -p src/provide_uterm_cloudflare/ui/static
COPY --from=frontend-build /src/${FRONTEND_DIR}/ \
        src/provide_uterm_cloudflare/ui/static/

EXPOSE 27788

# pywrangler dev: syncs vendor deps then starts wrangler dev
CMD ["uv", "run", "pywrangler", "dev", "--port", "27788", "--ip", "0.0.0.0"]
