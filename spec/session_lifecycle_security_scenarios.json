        "operation": "fragment_message",
        "transport": "browser",
        "route": "/ws/browser/{worker_id}/term",
        "worker_id": "lifecycle-fragment-browser",
        "direction": "browser_to_worker",
        "payload": "fragmented-browser-input",
        "fragment_count": 3,
        "oversized_bytes": 1048577
      },
      "expected": {
        "route": "browser_websocket",
        "status_code": 101,
        "fragment_count": 3,
        "pre_final_actions": 0,
        "post_final_actions": 1,
        "oversized_refused": true,
        "delivered_payloads": [
          "fragmented-browser-input"
