{
  "name": "provide-uterm-root",
  "private": true,
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  },
  "workspaces": [
    "packages/provide-uterm-frontend",
    "packages/provide-uterm-app",
    "packages/provide-uterm-ts"
  ],
  "scripts": {
    "clean:frontend-generated": "node scripts/clean-frontend-generated.mjs",
    "build:frontend": "npm run clean:frontend-generated && npm run build --workspace=packages/provide-uterm-frontend && npm run build --workspace=packages/provide-uterm-app && node scripts/publish-frontend-manifest.mjs",
    "build:widgets": "npm run build --workspace=packages/provide-uterm-frontend",
    "build:app": "npm run build --workspace=packages/provide-uterm-app",
    "dev:app": "npm run dev --workspace=packages/provide-uterm-app",
    "typecheck:frontend": "npm run typecheck --workspace=packages/provide-uterm-frontend",
    "typecheck:app": "npm run typecheck --workspace=packages/provide-uterm-app",
    "typecheck:ts": "npm run typecheck --workspace=packages/provide-uterm-ts",
    "test:ts": "npm run test --workspace=packages/provide-uterm-ts",
    "test:ts:coverage": "npm run test:coverage --workspace=packages/provide-uterm-ts",
    "test:ts:mutation": "npm run test:mutation --workspace=packages/provide-uterm-ts",
    "test:browser-consumer": "npm --prefix tests/fixtures/browser-consumer ci --ignore-scripts --install-links && npm --prefix tests/fixtures/browser-consumer run typecheck && npm --prefix tests/fixtures/browser-consumer run build",
    "lint:frontend": "npm run lint --workspace=packages/provide-uterm-frontend",
    "lint:app": "npm run lint --workspace=packages/provide-uterm-app",
    "lint:ts": "npm run lint --workspace=packages/provide-uterm-ts",
    "lint:ws-json": "uv run python scripts/check_bare_json_ws_sends.py",
    "fix:frontend": "npm run fix --workspace=packages/provide-uterm-frontend",
    "fix:app": "npm run fix --workspace=packages/provide-uterm-app"
  },
  "devDependencies": {
    "json-schema-to-typescript": "^15.0.4",
    "wrangler": "4.123.0"
  },
  "allowScripts": {
    "node-pty@1.1.0": true
  }
}
